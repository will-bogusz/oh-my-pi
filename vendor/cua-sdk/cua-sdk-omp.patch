+                .lock()
+                .unwrap()
+                .push(format!("stop:{}", self.target));
+            if self.fail_stop.load(Ordering::SeqCst) {
+                Err("native stop failed".into())
+            } else {
+                Ok(())
+            }
+        }
+    }
