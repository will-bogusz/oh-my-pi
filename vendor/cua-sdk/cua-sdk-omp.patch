+        for target in [1, 1, 2] {
+            registry
+                .with_lease(
+                    "session",
+                    || false,
+                    |l: &FakeLease| l.target == target,
+                    || Ok(fake(target, &events, &failed)),
+                    |l| {
+                        l.events
+                            .lock()
+                            .unwrap()
+                            .push(format!("capture:{}", l.target));
+                        Ok(())
+                    },
+                )
+                .unwrap();
+        }
+        registry.end("session").unwrap();
+        registry.end("session").unwrap();
+        assert_eq!(
+            *events.lock().unwrap(),
+            [
