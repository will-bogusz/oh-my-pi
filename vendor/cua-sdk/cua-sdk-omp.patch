+            "path": "ax",
+            "effect": "unverifiable",
+            "dispatch": "attempted",
+            "action": reply.action,
+            "ax_error": reply.code,
+            "retry": "reconcile_first"
+        }))
+    } else {
+        ToolResult::error(format!("AX action failed: {error}"))
