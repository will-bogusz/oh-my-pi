+            .recv_timeout(Duration::from_secs(1))
+            .unwrap();
+        assert!(cleanup_done_rx.try_recv().is_err());
+        assert_eq!(*events.lock().unwrap(), ["start:1"]);
+        finish.send(()).unwrap();
+        worker.join().unwrap().unwrap();
+        cleanup.join().unwrap();
+        assert_eq!(
+            *events.lock().unwrap(),
+            ["start:1", "capture_done", "stop:1"]
